# Telegram bot (required to poll; without token the process stays idle)
TELEGRAM_BOT_TOKEN=
# Extra super-admin Telegram user ids, comma-separated. 5320066517 is always super-admin.
TELEGRAM_ADMIN_IDS=5320066517
SUPER_ADMIN_TELEGRAM_ID=5320066517

# SQLite file path
DATABASE_PATH=./data/app.db

# Official Google Places API (New). Required to collect. Empty key = job refused, no demo data.
GOOGLE_PLACES_API_KEY=

# Optional: short completeness notes via OpenAI. If empty, a local heuristic is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# Polite job rate limits. JOB_MAX_RESULTS is a fallback if a job has no typed limit.
# The bot asks for a count (1–200) in /new.
JOB_REQUEST_DELAY_SECONDS=1.2
JOB_MAX_RESULTS=40
JOB_MAX_PAGES=3
